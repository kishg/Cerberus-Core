# Required: Cerbo Remote Console / admin password (NOT the VRM website password).
CERBERUS_MQTT_PASSWORD=

# Optional: overrides mqtt.host in config.yaml. Useful when the Cerbo is on DHCP.
# You can also just use 'venus.local' in config.yaml — the Cerbo advertises mDNS
# by default, so the hostname follows the device across IP changes.
CERBERUS_MQTT_HOST=

# Optional: SQLite path override (dev convenience; prod uses config.yaml = /data/cerberus.db).
CERBERUS_SQLITE_PATH=

# Optional: Bearer token for the off-site sync target. Used only when sync.enabled=true.
CERBERUS_SYNC_TOKEN=
